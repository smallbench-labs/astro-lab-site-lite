---
import Base from "../layouts/Base.astro";
import { useT, tl, fmtDate, type Lang } from "../i18n/ui";
const lang: Lang = "en";
const t = useT(lang);
import PubEntry from "../components/PubEntry.astro";
import { lab, positions, members, alumni, type Role } from "../data/lab";
import { publications } from "../lib/pubs";
import { getCollection } from "astro:content";
const roles: Role[] = ["pi", "postdoc", "phd", "ms", "ug"];
const selected = publications.filter((p) => p.selected);
const news = (await getCollection("news", (e) => e.id.startsWith("en/"))).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
// Fictional tide-gauge trace for the masthead figure
const pts = Array.from({ length: 97 }, (_, i) => { const x = i * 10; const y = 60 - 34 * Math.sin(i / 7.6) * (0.75 + 0.25 * Math.cos(i / 23)) - 4 * Math.sin(i * 1.7); return `${x},${y.toFixed(1)}`; }).join(" ");
---
<Base lang={lang}>
  <section class="mx-auto max-w-[1080px] px-6 pt-14 md:pt-20 grid md:grid-cols-12 gap-6">
    <p class="md:col-span-3 meta pt-4">{tl(lang, lab.full)}</p>
    <div class="md:col-span-9">
      <h1 class="text-[clamp(2.4rem,5.4vw,3.6rem)] leading-[1.06] max-w-[20ch]">{tl(lang, lab.mission).split(/(?<=[.。])\s*/)[0]}</h1>
      <p class="mt-6 text-[20px] leading-[1.55] text-ink-2 max-w-[56ch]">{tl(lang, lab.mission).split(/(?<=[.。])\s*/).slice(1).join(" ")}</p>
    </div>
  </section>

  <figure class="mx-auto max-w-[1080px] px-6 mt-14 grid md:grid-cols-12 gap-6">
    <figcaption class="md:col-span-3 meta md:pt-2 order-2 md:order-1">Fig. 1 — TideNet node 17, Mangrove Point. 96 h water level (sample data).</figcaption>
    <div class="md:col-span-9 order-1 md:order-2 border-y border-line py-4">
      <svg viewBox="0 0 960 120" class="w-full h-auto" role="img" aria-label="Line chart of water level at TideNet node 17 over 96 hours: four tidal cycles rising and falling between low and high water, with one marked peak near hour 60. Sample data.">
        {[20, 60, 100].map((y) => <line x1="0" x2="960" y1={y} y2={y} stroke="var(--line)" stroke-dasharray="2 4" />)}
        <polyline points={pts} fill="none" stroke="var(--accent)" stroke-width="1.6" />
        <circle cx="610" cy="27" r="4" fill="var(--cite)" />
      </svg>
    </div>
  </figure>

  {positions.length > 0 && (
    <aside class="mx-auto max-w-[1080px] px-6 mt-14 grid md:grid-cols-12 gap-6">
      <p class="md:col-span-3 meta pt-1 text-cite">{t("home.hiring")}</p>
      <p class="md:col-span-9 bg-highlight px-4 py-3 text-[16px]">{tl(lang, positions[0].title)} — {t("join.deadline")} {positions[0].deadline}. <a class="link inline-flex items-center min-h-11 font-sans text-[14px]" href={`mailto:${lab.email}`}>{lab.email}</a></p>
    </aside>
  )}

  <section id="publications" class="mx-auto max-w-[1080px] px-6 mt-16 grid md:grid-cols-12 gap-6">
    <h2 class="md:col-span-3 meta pt-7">{t("home.selected")}</h2>
    <div class="md:col-span-9 border-t border-ink">
      {selected.map((p) => <PubEntry pub={p} lang={lang} />)}
      
    </div>
  </section>

  <section id="people" class="mx-auto max-w-[1080px] px-6 mt-16 grid md:grid-cols-12 gap-6">
    <h2 class="md:col-span-3 meta pt-5">{t("people.title")}</h2>
    <ul class="md:col-span-9 border-t border-ink grid sm:grid-cols-2 gap-x-10">
      {roles.flatMap((r) => members.filter((m) => m.role === r)).map((m) => (
        <li class="flex gap-4 py-4 border-b border-line">
          <span aria-hidden="true" class="shrink-0 size-12 rounded-full grid place-items-center font-sans text-[14px] font-medium bg-paper-2 border border-line text-accent">{m.initials}</span>
          <div><h3 class="text-[1.15rem] leading-tight">{m.name}</h3><p class="meta mt-0.5">{t(`role.${m.role}`)}</p><p class="text-[14px] text-ink-2">{tl(lang, m.topic)}</p></div>
        </li>
      ))}
    </ul>
    <p class="md:col-start-4 md:col-span-9 text-[15px] text-ink-2"><span class="meta">{t("people.alumni")}</span> {alumni.map((a) => `${a.name} (${a.degree})`).join(" · ")}</p>
  </section>

  <section id="news" class="mx-auto max-w-[1080px] px-6 mt-16 grid md:grid-cols-12 gap-6">
    <h2 class="md:col-span-3 meta pt-5">{t("home.news")}</h2>
    <ol class="md:col-span-9 border-t border-ink">
      {news.map((n) => <li class="grid sm:grid-cols-[120px_1fr] gap-x-6 items-center py-2 border-b border-line"><time class="meta" datetime={n.data.date.toISOString()}>{fmtDate(lang, n.data.date)}</time><span class="inline-flex items-center min-h-11 text-[18px] font-display">{n.data.title}</span></li>)}
    </ol>
  </section>
</Base>
