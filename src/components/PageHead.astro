---
interface Props { title: string; lead?: string; kicker?: string }
const { title, lead, kicker } = Astro.props;
---
<header class="mx-auto max-w-[1080px] px-6 pt-14 md:pt-20 pb-10 grid md:grid-cols-12 gap-6">
  <p class="md:col-span-3 meta pt-3">{kicker}</p>
  <div class="md:col-span-9">
    <h1 class="text-[clamp(2.1rem,4.5vw,2.65rem)] leading-[1.1]">{title}</h1>
    {lead && <p class="mt-4 text-[20px] leading-[1.5] text-ink-2 max-w-[58ch]">{lead}</p>}
  </div>
</header>
